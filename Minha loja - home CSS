    flex: wrap;
    gap: 15px;
}

img {
    width: 250px;
    height: 250px;
    margin: 40px;
       align-items: center;
       gap: 24px;
    border: 1px solid white;
}

h1 {
    color: #551c5a;
    text-align: center;
}

h2 {
    color: #551c5a;
    text-align: center;
}

h3 {
    color: #551c5a;
    text-align: center;
}
p {
    color: #551c5a;
    text-align: center;
}
label {
    display: block;
    margin-top: 15px;
}



input {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #660080;
    border-radius: 5px;
    box-sizing: border-box;
}
button {
    background-color: #660080;
    color: white;
    width: 100%;
    padding: 10px;
    margin-top: 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}
button:hover {
    background-color: #660080;
}
