body {
    background-color:#a1849d;
    font-family: Arial, sans-serif;
    margin: 0px;
    padding: 20px;
}
.caixa-login {
    background-color: rgb(189, 139, 170);
    max-width: 300px;
    margin: 0px auto;
    padding: 25px;
    border-radius: 10px;
}

.produtos{
    border: 16px solid rgb(171, 60, 154);
        background-color:rgb(195, 189, 189);
        max-width: 100%;
        max-width: 200px;
